{
  "manifest_version": 3,
  "name": "淘啊竞品采集器",
  "version": "1.3.8",
  "version_name": "V1.3.8 多类目参数与店铺指标",
  "minimum_chrome_version": "109",
  "options_page": "listing-diagnostics.html",
  "devtools_page": "load-devtools.html",
  "description": "由用户主动触发，在后台读取淘宝/天猫商品页公开信息并发送到淘啊竞品分析工作台。",
  "permissions": ["activeTab", "tabs", "storage", "webNavigation", "downloads", "offscreen", "scripting", "alarms"],
  "host_permissions": [
    "https://item.taobao.com/*",
    "https://detail.tmall.com/*",
    "https://*.tmall.com/*",
    "https://*.taobao.com/*",
    "https://*.alicdn.com/*",
    "https://*.alicdn.net/*",
    "https://desc.alicdn.com/*",
    "https://taoa-competitor-lab.jamesletter2013.chatgpt.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "采集当前淘宝/天猫商品",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://*.tmall.com/*",
        "https://*.taobao.com/*",
        "https://desc.alicdn.com/*"
      ],
      "js": ["product-facts-runtime.js", "collector.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://taoa-competitor-lab.jamesletter2013.chatgpt.site/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
