# Server-only. Hosted values belong in Sites runtime secrets, never in VITE_*.
DEEPSEEK_API_KEY=
# Explicit administrator opt-in; disabled until the key and billing are ready.
AI_ENABLED=false
# Company key is denied by default, including when AI_ENABLED=true.
# Comma-separated authenticated Sites user IDs, never a frontend toggle.
AI_COMPANY_USER_IDS=
# Set a daily limit to unlimited only with administrator billing approval.
AI_DAILY_USER_LIMIT=20
AI_DAILY_TEAM_LIMIT=100
